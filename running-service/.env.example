# CORS 설정
# 쉼표(,)로 구분
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=
CORS_ALLOWED_HEADERS=

# 데이터베이스 설정
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Redis 설정
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Kafka 설정 — 이름 앞에 붙일 환경: dev(로컬) · test · prod. 다른 값이면 기동하지 않는다
KAFKA_ENV=dev
# 완료 이벤트 구독 — 로컬은 브로커(VPC 안 주소)에 닿지 않아 false. true면 아래 접속 값이 모두 있어야 한다
KAFKA_CONSUMER_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# 브로커 CA 인증서(PEM) 절대 경로
KAFKA_SSL_CA_LOCATION=

# JPA 설정
# JPA_DDL: validate | update | create | create-drop
JPA_DDL=
JPA_SHOW_SQL=
JPA_FORMAT_SQL=
JPA_OPEN_IN_VIEW=

# 타임존 설정 (예: Asia/Seoul)
APP_TIME_ZONE=

# JWT 설정
# SECRET: 32Byte 이상 랜덤 문자열 / TTL: Duration 형식 (예: 60s, 15m, 7d)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=

# Google OAuth 설정
GOOGLE_CLIENT_ID=

# Kakao OAuth 설정
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
KAKAO_UNLINK_ADMIN_KEY=

# Apple OAuth 설정
APPLE_CLIENT_ID=

# AWS SES 설정
SES_REGION=
SES_FROM_ADDRESS=
SES_FROM_NAME=
# 로컬 테스트 전용 — 비우면 IAM Role 사용
SES_TEST_ACCESS_KEY_ID=
SES_TEST_SECRET_ACCESS_KEY=

# AWS S3 설정
S3_REGION=
S3_USER_ASSET_BUCKET=
S3_GPS_TRACK_BUCKET=
S3_RECORD_CARD_BUCKET=
# 기록 카드 음악 버킷 — AI 서버가 올린다. 앱은 보기 URL만 서명한다
S3_MUSIC_BUCKET=
# 로컬 테스트 전용 — 비우면 IAM Role 사용
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 로컬 가짜 AI 음악 완료 — 로컬엔 Kafka·AI 서버가 없어, 카드를 만들면 5초 뒤 음악을 COMPLETED로 바꿔 준다
# local 프로필 + KAFKA_CONSUMER_ENABLED=false + KAFKA_ENV=dev일 때만 쓰인다 — test·deploy는 앞의 두 값을 넣지 않고,
# 로컬 앱을 test DB에 붙이면 KAFKA_ENV=test라 꺼진다
# ENABLED: 빼면 켜진다(기본 true). 빈 값은 꺼짐으로 읽히니 넣을 거면 true·false를 적는다. E2E는 false
# MUSIC_KEY: 기본곡·사진곡 모두에 배정할 음악 S3 key(로컬 버킷에 미리 올려 둔 파일). 켜졌는데 비면 기동하지 않는다
RECORD_CARD_MUSIC_LOCAL_AI_ENABLED=true
RECORD_CARD_MUSIC_LOCAL_AI_MUSIC_KEY=

# FCM 설정
FCM_SERVICE_ACCOUNT_BASE64=
# 푸시 끄기 — 쉼표(,)로 구분, 비우면 모두 보냄
PUSH_DISABLED_TYPES=

# 관리자 API 키
ADMIN_KEY=

# 로그 파일 디렉터리 (예: ./logs)
LOG_DIR=
