# E2E 전용 더미 환경변수 — CI가 사용
# 노출돼도 무해한 값만 허용, 실제 키 금지

# local 프로필 — SES 실제 발송 없음
SPRING_PROFILES_ACTIVE=local

# postgres 컨테이너 초기화용 — app이 아니라 postgres 서비스가 읽는 값
POSTGRES_DB=runiverse_e2e
POSTGRES_USER=runiverse
POSTGRES_PASSWORD=runiverse

# CORS 설정
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*

# 데이터베이스 설정 — compose 네트워크 안에서는 서비스 이름이 곧 호스트명
DATABASE_URL=jdbc:postgresql://postgres:5432/runiverse_e2e
DATABASE_USERNAME=runiverse
DATABASE_PASSWORD=runiverse

# Redis 설정
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis

# JPA 설정 — 빈 DB에 스키마를 만들어야 해서 배포용 validate 불가
# create-drop으로 매 실행 전부 지우고 새로 시작
JPA_DDL=create-drop
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
JPA_OPEN_IN_VIEW=false

# 타임존 설정 — TimeZoneConfig가 기본값 없이 요구, 비우면 기동 실패
APP_TIME_ZONE=Asia/Seoul

# JWT 설정 — JwtSecretKeyFactory가 32바이트 미만이면 기동 실패
JWT_ACCESS_SECRET=e2e-access-token-secret-for-ci-only-not-a-real-key
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=e2e-refresh-token-secret-for-ci-only-not-a-real-key
JWT_REFRESH_TTL=7d

# Kakao OAuth 설정 — E2E에서 실제 호출 없음
KAKAO_REST_API_KEY=e2e-client-id
KAKAO_CLIENT_SECRET=e2e-client-secret
KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao

# Google OAuth 설정
GOOGLE_CLIENT_ID=e2e-client-id
GOOGLE_CLIENT_SECRET=e2e-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173

# AWS SES 설정 — local 프로필이라 안 쓰이지만 SesProperties가 @NotBlank라 비우면 기동 실패
SES_REGION=ap-northeast-2
SES_FROM_ADDRESS=no-reply@runiverse.test

# AWS S3 설정
S3_REGION=ap-northeast-2
S3_USER_ASSET_BUCKET=runiverse-e2e-user-asset-dummy
S3_GPS_TRACK_BUCKET=runiverse-e2e-gps-track-dummy
